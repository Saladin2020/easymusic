extends Node
## Easy Music player: add as an autoload named MusicPlayer (the export does this for you).
##
##   MusicPlayer.play("village_day")      # cross-fade from the current song (fade_time seconds)
##   MusicPlayer.play("title_theme", 0.0) # hard cut; the intro plays once, then loops from loop_start
##   MusicPlayer.stop(1.5)                # fade out
##   MusicPlayer.position()               # seconds into the current stream
##
## Streams are the exported .ogg (AudioStreamOggVorbis: loop + loop_offset) or .wav (AudioStreamWAV:
## LOOP_FORWARD with loop_begin / loop_end) files listed in res://easymusic/music.json.
## Generated by Easy Music (MIT).

signal song_changed(id: String)

const MANIFEST := "res://easymusic/music.json"

@export var bus := &"Master"
@export var fade_time := 1.0
@export var volume_db := 0.0

var songs: Dictionary = {}  # id -> manifest entry
var current := ""
var _streams: Dictionary = {}
var _a: AudioStreamPlayer
var _b: AudioStreamPlayer
var _tween: Tween


func _init() -> void:
	_a = AudioStreamPlayer.new()
	_b = AudioStreamPlayer.new()
	for p in [_a, _b]:
		p.bus = bus
		add_child(p)
	if FileAccess.file_exists(MANIFEST):
		load_manifest(MANIFEST)


## Load (or reload) a manifest. Returns false when the file is missing or broken.
func load_manifest(path: String) -> bool:
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		push_warning("MusicPlayer: cannot open %s" % path)
		return false
	var data = JSON.parse_string(f.get_as_text())
	if typeof(data) != TYPE_DICTIONARY or not data.has("songs"):
		push_warning("MusicPlayer: bad manifest %s" % path)
		return false
	songs.clear()
	_streams.clear()
	for s in data["songs"]:
		songs[str(s["id"])] = s
	return true


func ids() -> Array:
	var out := songs.keys()
	out.sort()
	return out


## The looping AudioStream of a song (cached).
func stream_of(id: String) -> AudioStream:
	if _streams.has(id):
		return _streams[id]
	if not songs.has(id):
		push_warning("MusicPlayer: unknown song %s" % id)
		return null
	var s: Dictionary = songs[id]
	var st: AudioStream = load(str(s["file"]))
	if st is AudioStreamOggVorbis:
		st.loop = true
		st.loop_offset = float(s["loop_start"])
	elif st is AudioStreamWAV:
		st.loop_mode = AudioStreamWAV.LOOP_FORWARD
		st.loop_begin = int(s["loop_start_sample"])
		st.loop_end = int(s["loop_end_sample"])
	_streams[id] = st
	return st


## Play a song, cross-fading from the current one. fade < 0 uses fade_time.
func play(id: String, fade: float = -1.0) -> void:
	if id == current and _a.playing:
		return
	var st := stream_of(id)
	if st == null:
		return
	var t := fade_time if fade < 0.0 else fade
	var old := _a
	_a = _b
	_b = old
	_a.stream = st
	_a.volume_db = volume_db if t <= 0.0 else -40.0
	_a.play()
	if _tween:
		_tween.kill()
	if t > 0.0:
		_tween = create_tween().set_parallel(true)
		_tween.tween_property(_a, "volume_db", volume_db, t)
		if _b.playing:
			_tween.tween_property(_b, "volume_db", -60.0, t)
			_tween.chain().tween_callback(_b.stop)
	else:
		_b.stop()
	current = id
	song_changed.emit(id)


## Fade out and stop. fade < 0 uses fade_time.
func stop(fade: float = -1.0) -> void:
	var t := fade_time if fade < 0.0 else fade
	if _tween:
		_tween.kill()
	current = ""
	if t <= 0.0:
		_a.stop()
		_b.stop()
		return
	_tween = create_tween().set_parallel(true)
	for p in [_a, _b]:
		if p.playing:
			_tween.tween_property(p, "volume_db", -60.0, t)
	_tween.chain().tween_callback(_stop_all)


func _stop_all() -> void:
	_a.stop()
	_b.stop()


func is_playing() -> bool:
	return _a.playing


func position() -> float:
	return _a.get_playback_position() if _a.playing else 0.0
